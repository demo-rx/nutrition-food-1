# Server environment — copy to .env and fill in values
PORT=3000

# Analysis mode: mock | gemini
# mock = demo data (works without API key)
# gemini = real AI vision analysis
ANALYZE_MODE=mock

# Get a free key at https://aistudio.google.com/apikey
# Must start with AIza (not AQ. or other formats)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MODEL_FALLBACKS=gemini-2.0-flash-lite,gemini-1.5-flash,gemini-flash-latest
